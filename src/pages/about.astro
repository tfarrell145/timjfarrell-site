---
import Base from '../layouts/Base.astro';
---
<Base title="About — Tim Farrell">
  <section class="wrap" style="padding-block: 3.5rem">
    <div class="prose">
      <p class="eyebrow">About</p>
      <h1 style="margin-top:.6rem; font-size: var(--step-3)">About</h1>
      <p>I live in Vermont. I spend a lot of time on systems that were working
      fine until I improved them.</p>
      <p>This site is a rebuild, started in September 2026, replacing something
      that had gone stale years earlier. Sections arrive as they get written.</p>
      <h2>Elsewhere</h2>
      <ul class="rows">
        <li><a href="https://instagram.com/tim.j.farrell">Instagram</a></li>
        <li><a href="https://github.com/tfarrell145">GitHub</a></li>
      </ul>
    </div>
  </section>
</Base>
