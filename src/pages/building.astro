---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
const title = 'building';
---
<Base title={title.charAt(0).toUpperCase() + title.slice(1) + ' — Tim Farrell'}>
  <section class="wrap" style="padding-block: 3.5rem">
    <div class="prose">
      <p class="eyebrow">{title}</p>
      <h1 style="margin-top:.6rem; font-size: var(--step-3)">{title.charAt(0).toUpperCase() + title.slice(1)}</h1>
      <Callout title="Not written yet" icon="◷" hue="writing">
        <p>This section is a stub. Content lands here in a later pass.</p>
      </Callout>
    </div>
  </section>
</Base>
