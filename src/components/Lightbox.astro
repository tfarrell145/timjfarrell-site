---
// Click any image inside a figure to open it full size. Arrow keys, the
// on-screen buttons or a swipe step through every figure image on the page.
---
<dialog class="lightbox" aria-label="Image viewer">
  <figure>
    <img alt="" />
    <figcaption><span class="lb-count"></span> <span class="lb-text"></span></figcaption>
  </figure>
  <button class="lb-close" type="button" aria-label="Close">✕</button>
  <button class="lb-prev" type="button" aria-label="Previous image">‹</button>
  <button class="lb-next" type="button" aria-label="Next image">›</button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const images = [...document.querySelectorAll<HTMLImageElement>('main figure img')];

  if (dialog && images.length) {
    const view = dialog.querySelector('img')!;
    const count = dialog.querySelector('.lb-count')!;
    const text = dialog.querySelector('.lb-text')!;
    const single = images.length === 1;
    dialog.classList.toggle('single', single);
    let index = 0;

    const caption = (img: HTMLImageElement) =>
      img.closest('figure')?.querySelector('figcaption')?.textContent?.trim() || img.alt;

    const show = (i: number) => {
      index = (i + images.length) % images.length;
      const img = images[index];
      view.src = img.currentSrc || img.src;
      view.alt = img.alt;
      count.textContent = single ? '' : `${index + 1} / ${images.length}`;
      text.textContent = img.alt || caption(img);
      for (const n of [index - 1, index + 1]) {
        new Image().src = images[(n + images.length) % images.length].src;
      }
    };

    images.forEach((img, i) => {
      img.classList.add('zoomable');
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      const open = () => { show(i); dialog.showModal(); };
      img.addEventListener('click', open);
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
      });
    });

    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === dialog.querySelector('figure')) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    let startX = 0;
    dialog.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style is:global>
  .zoomable { cursor: zoom-in; }
  dialog.lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: rgba(10, 10, 12, .94); color: #eee;
  }
  dialog.lightbox::backdrop { background: rgba(10, 10, 12, .94); }
  dialog.lightbox figure {
    margin: 0; height: 100%; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: .9rem;
    padding: 3.5rem 4rem 1.5rem;
  }
  dialog.lightbox img {
    max-width: 100%; max-height: calc(100dvh - 8rem); width: auto; height: auto;
    object-fit: contain; border: 0; border-radius: 6px;
  }
  dialog.lightbox figcaption {
    margin: 0; color: #bbb; text-align: center; max-width: 44rem;
    font-size: var(--step--1);
  }
  .lb-count { color: #888; font-variant-numeric: tabular-nums; margin-right: .5rem; }
  dialog.lightbox button {
    position: absolute; background: rgba(255, 255, 255, .08); color: #eee;
    border: 1px solid rgba(255, 255, 255, .15); border-radius: 999px;
    width: 2.6rem; height: 2.6rem; font-size: 1.4rem; line-height: 1;
    display: grid; place-items: center; cursor: pointer;
  }
  dialog.lightbox button:hover { background: rgba(255, 255, 255, .18); }
  .lb-close { top: .9rem; right: .9rem; font-size: 1rem !important; }
  .lb-prev { left: .9rem; top: 50%; transform: translateY(-50%); }
  .lb-next { right: .9rem; top: 50%; transform: translateY(-50%); }
  dialog.lightbox.single .lb-prev, dialog.lightbox.single .lb-next { display: none; }
  @media (max-width: 34rem) {
    dialog.lightbox figure { padding: 4rem .75rem 4.5rem; }
    dialog.lightbox img { max-height: calc(100dvh - 11.5rem); }
    .lb-prev, .lb-next { top: auto; bottom: 1rem; transform: none; }
  }
</style>
