---
// A grid of screenshots or photos inside one figure. Each image opens in the
// site-wide Lightbox, which steps through every figure image on the page.
interface Item { src: string; alt: string; label?: string; width?: number; height?: number }
const { items, caption, cols = 3 } = Astro.props as { items: Item[]; caption?: string; cols?: number };
---
<figure class="gallery" style={`--gallery-cols: ${cols}`}>
  <div class="gallery-grid">
    {items.map((i) => (
      <div class="gallery-item">
        <img src={i.src} alt={i.alt} width={i.width ?? 780} height={i.height ?? 1688} loading="lazy" decoding="async" />
        {i.label && <span class="gallery-label">{i.label}</span>}
      </div>
    ))}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .gallery-grid {
    display: grid; gap: .9rem .7rem;
    grid-template-columns: repeat(var(--gallery-cols), minmax(0, 1fr));
  }
  .gallery-item { display: flex; flex-direction: column; gap: .4rem; }
  .gallery-item img { width: 100%; height: auto; }
  .gallery-label { font-size: var(--step--1); color: var(--ink-muted); line-height: 1.35; }
  @media (max-width: 34rem) {
    .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
