---
---
<figure class="diagram">
  <svg viewBox="0 0 680 430" role="img"
       aria-label="On the server, a plugin stops each app at 3 am, archives its data folder and starts it again. Backrest sends the boot drive and the archives to a second box on the home network, which only accepts additions. On the second box, the backups live in an encrypted, deduplicated restic repository, and a weekly job there removes old snapshots and checks the repository. An off-site copy is planned but not built.">
    <defs>
      <marker id="bk-ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
      </marker>
      <marker id="bk-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" style="fill: var(--accent)" />
      </marker>
    </defs>

    <!-- regions -->
    <g stroke="currentColor" fill="none" stroke-width="1.25" stroke-dasharray="4 4" opacity="0.55">
      <rect x="16" y="30" width="290" height="300" rx="8" />
      <rect x="374" y="30" width="290" height="300" rx="8" />
    </g>
    <g fill="currentColor" font-family="ui-monospace, monospace" font-size="10" letter-spacing="0.06em" opacity="0.55">
      <text x="30" y="50">SERVER</text>
      <text x="388" y="50">BACKUP BOX</text>
    </g>

    <!-- server column -->
    <g stroke="currentColor" fill="none" stroke-width="1.25">
      <rect x="56" y="66" width="210" height="44" rx="6" />
      <rect x="56" y="162" width="210" height="44" rx="6" />
      <rect x="56" y="258" width="210" height="52" rx="6" />
    </g>
    <g fill="currentColor" font-family="Inter, system-ui, sans-serif" font-size="12" text-anchor="middle">
      <text x="161" y="86">App data</text>
      <text x="161" y="101" font-size="10" opacity="0.6">every container's folder</text>
      <text x="161" y="182">Archives</text>
      <text x="161" y="197" font-size="10" opacity="0.6">one tar per app, uncompressed</text>
      <text x="161" y="278">Backrest</text>
      <text x="161" y="293" font-size="10" opacity="0.6">04:00 boot drive</text>
      <text x="161" y="305" font-size="10" opacity="0.6">04:30 archives</text>
    </g>
    <g stroke="currentColor" stroke-width="1.25">
      <line x1="161" y1="110" x2="161" y2="156" marker-end="url(#bk-ar)" />
      <line x1="161" y1="206" x2="161" y2="252" marker-end="url(#bk-ar)" />
    </g>
    <g fill="currentColor" font-family="Inter, system-ui, sans-serif" font-size="10" opacity="0.7">
      <text x="170" y="131">03:00 stop, archive,</text>
      <text x="170" y="144">start again</text>
    </g>

    <!-- link -->
    <line x1="266" y1="284" x2="410" y2="284" stroke-width="1.6" style="stroke: var(--accent)" marker-end="url(#bk-acc)" />
    <text x="340" y="276" font-family="Inter, system-ui, sans-serif" font-size="10" text-anchor="middle"
          style="fill: var(--accent)">add only</text>
    <text x="340" y="300" font-family="Inter, system-ui, sans-serif" font-size="10" text-anchor="middle"
          fill="currentColor" opacity="0.6" font-size="9">home network</text>

    <!-- backup box column -->
    <g stroke="currentColor" fill="none" stroke-width="1.25">
      <rect x="414" y="66" width="210" height="44" rx="6" />
      <rect x="414" y="162" width="210" height="44" rx="6" />
      <rect x="414" y="258" width="210" height="52" rx="6" />
    </g>
    <g fill="currentColor" font-family="Inter, system-ui, sans-serif" font-size="12" text-anchor="middle">
      <text x="519" y="86">Weekly cleanup</text>
      <text x="519" y="101" font-size="10" opacity="0.6">Sun 05:00 forget, prune, check</text>
      <text x="519" y="182">restic repository</text>
      <text x="519" y="197" font-size="10" opacity="0.6">encrypted, deduplicated</text>
      <text x="519" y="278">rest-server</text>
      <text x="519" y="293" font-size="10" opacity="0.6">append-only: new snapshots in,</text>
      <text x="519" y="305" font-size="10" opacity="0.6">nothing deleted from outside</text>
    </g>
    <g stroke="currentColor" stroke-width="1.25">
      <line x1="519" y1="258" x2="519" y2="212" marker-end="url(#bk-ar)" />
      <line x1="519" y1="110" x2="519" y2="156" marker-end="url(#bk-ar)" />
    </g>

    <!-- off-site, not built -->
    <g opacity="0.4">
      <rect x="414" y="360" width="210" height="44" rx="6" fill="none" stroke="currentColor"
            stroke-width="1.25" stroke-dasharray="3 3" />
      <text x="519" y="380" fill="currentColor" font-family="Inter, system-ui, sans-serif" font-size="12" text-anchor="middle">Off-site copy</text>
      <text x="519" y="395" fill="currentColor" font-family="Inter, system-ui, sans-serif" font-size="10" text-anchor="middle">not built yet</text>
      <line x1="624" y1="184" x2="648" y2="184" stroke="currentColor" stroke-width="1.25" />
      <line x1="648" y1="184" x2="648" y2="382" stroke="currentColor" stroke-width="1.25" stroke-dasharray="3 3" />
      <line x1="648" y1="382" x2="630" y2="382" stroke="currentColor" stroke-width="1.25" stroke-dasharray="3 3" marker-end="url(#bk-ar)" />
    </g>
  </svg>
  <figcaption>Every night, from app data to a box that will not let the server delete anything.
  The dashed box is the part that is still missing.</figcaption>
</figure>
